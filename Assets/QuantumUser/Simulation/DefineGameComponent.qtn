    list<EntityRef> PlayerList;

	[FreeOnComponentRemoved]
    list<int> valueList;
}

component GameViewInfo
{
	EntityRef playerLocal;
}


enum RotationLineWiner
{
	Vertical, Horizontal, DiagonalRight, DiagonalLeft
}
enum PlayerFacing
{
	Left, Right
}

enum PlayerType
{
	None, Cross, Cricle
}

enum GameState
{
	Playing, Win, Lose, Tie, Reset
}

global
{
	GameState CurrentGameState;
	PlayerType localPlayerType;
	bool isReset;
	bool isInitGame;
	int rotation;
	int winIndex;
	int valueWiner;
	int scoreCross;
	int scoreCircle;

	bool isStartGameList;
